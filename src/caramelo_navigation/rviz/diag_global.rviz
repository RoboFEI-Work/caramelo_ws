# Vista escondida 'global' da gravacao da corrida (2026-11-13). Roda num X virtual
# (Xvfb) e vira runs/run_<stamp>/videos/global.mp4; o operador nao ve esta janela.
# caramelo_run_common troca @...@ (posicao da janela no X virtual e, nas vistas de
# mapa inteiro, a vista que enquadra o mapa). MarkerArray usa 'Topic' (rviz2 Jazzy).
# NUNCA /marker, /evaluation, /trajectories: o DWB/MPPI so' montam com assinante.
Panels: []  # sem painel: a janela inteira e' mapa (vista escondida, ninguem clica)
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.8
    Binary representation: false
    Binary threshold: 100
    Class: rviz_default_plugins/Map
    Color Scheme: map
    Draw Behind: false
    Enabled: true
    Name: Mapa
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map_updates
    Use Timestamp: false
    Value: true
  - Alpha: 0.4
    Binary representation: false
    Binary threshold: 100
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: true
    Name: Costmap global
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap_updates
    Use Timestamp: false
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description File: ''
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_description
    Enabled: true
    Links:
      All Links Enabled: true
      Expand Joint Details: false
      Expand Link Details: false
      Expand Tree: false
      Link Tree Style: ''
    Mass Properties:
      Inertia: false
      Mass: false
    Name: Robo
    TF Prefix: ''
    Update Interval: 0
    Value: true
    Visual Enabled: true
  - Alpha: 0.9
    Class: rviz_default_plugins/Polygon
    Color: 255; 255; 255
    Enabled: true
    Name: Footprint
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/published_footprint
    Value: true
  - Alpha: 1
    Arrow Length: 0.04
    Axes Length: 0.3
    Axes Radius: 0.01
    Class: rviz_default_plugins/PoseArray
    Color: 255; 140; 0
    Enabled: true
    Head Length: 0.02
    Head Radius: 0.02
    Name: LARANJA expansoes
    Shaft Length: 0.02
    Shaft Radius: 0.01
    Shape: Arrow (Flat)
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /expansions
    Value: true
  - Alpha: 0.8
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 200; 120; 255
    Enabled: true
    Head Diameter: 0.3
    Head Length: 0.2
    Length: 0.3
    Line Style: Billboards
    Line Width: 0.025
    Name: plano sem suavizar
    Offset:
      X: 0
      Y: 0
      Z: 0.015
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.03
    Shaft Diameter: 0.1
    Shaft Length: 0.1
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /unsmoothed_plan
    Value: true
  - Alpha: 0.7
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 140; 170; 255
    Enabled: true
    Head Diameter: 0.3
    Head Length: 0.2
    Length: 0.3
    Line Style: Billboards
    Line Width: 0.035
    Name: AZUL CLARO plano anterior
    Offset:
      X: 0
      Y: 0
      Z: 0.01
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.03
    Shaft Diameter: 0.1
    Shaft Length: 0.1
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /diag/plano_anterior
    Value: true
  - Alpha: 1.0
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 0; 90; 255
    Enabled: true
    Head Diameter: 0.3
    Head Length: 0.2
    Length: 0.3
    Line Style: Billboards
    Line Width: 0.05
    Name: AZUL plano global
    Offset:
      X: 0
      Y: 0
      Z: 0.02
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.03
    Shaft Diameter: 0.1
    Shaft Length: 0.1
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /plan
    Value: true
  - Alpha: 1.0
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 255; 220; 0
    Enabled: true
    Head Diameter: 0.3
    Head Length: 0.2
    Length: 0.3
    Line Style: Billboards
    Line Width: 0.05
    Name: AMARELO percorrido
    Offset:
      X: 0
      Y: 0
      Z: 0.03
    Pose Color: 255; 85; 255
    Pose Style: None
    Radius: 0.03
    Shaft Diameter: 0.1
    Shaft Length: 0.1
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /diag/trilha_real
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: VERMELHO eventos
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /diag/eventos
    Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 10
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: @VIEW_SCALE@
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: @VIEW_X@
      Y: @VIEW_Y@
    Saved: null
Window Geometry:
  Displays:
    collapsed: true
  Height: @HEIGHT@
  Hide Left Dock: true
  Hide Right Dock: true
  Width: @WIDTH@
  X: @WIN_X@
  Y: @WIN_Y@
