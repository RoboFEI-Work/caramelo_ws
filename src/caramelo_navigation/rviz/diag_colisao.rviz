# Vista escondida 'colisao' da gravacao da corrida (2026-11-13). Roda num X virtual
# (Xvfb) e vira runs/run_<stamp>/videos/colisao.mp4; o operador nao ve esta janela.
# caramelo_run_common troca @...@ (posicao da janela no X virtual e, nas vistas de
# mapa inteiro, a vista que enquadra o mapa). MarkerArray usa 'Topic' (rviz2 Jazzy).
# NUNCA /marker, /evaluation, /trajectories: o DWB/MPPI so' montam com assinante.
Panels: []  # sem painel: a janela inteira e' mapa (vista escondida, ninguem clica)
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.85
    Binary representation: false
    Binary threshold: 100
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: true
    Name: Costmap local
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap_updates
    Use Timestamp: false
    Value: true
  - Alpha: 0.7
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 120; 120; 120
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 0
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: LiDAR cru 360
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 3
    Size (m): 0.02
    Style: Flat Squares
    Topic:
      Depth: 50
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan_raw
    Use Fixed Frame: true
    Use rainbow: false
    Value: true
  - Alpha: 1.0
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 255; 255; 255
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 0
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: LiDAR usado
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 3
    Size (m): 0.03
    Style: Flat Squares
    Topic:
      Depth: 50
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan
    Use Fixed Frame: true
    Use rainbow: false
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/RobotModel
    Collision Enabled: false
    Description File: ''
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_description
    Enabled: true
    Links:
      All Links Enabled: true
      Expand Joint Details: false
      Expand Link Details: false
      Expand Tree: false
      Link Tree Style: ''
    Mass Properties:
      Inertia: false
      Mass: false
    Name: Robo
    TF Prefix: ''
    Update Interval: 0
    Value: true
    Visual Enabled: true
  - Alpha: 0.9
    Class: rviz_default_plugins/Polygon
    Color: 255; 255; 255
    Enabled: true
    Name: Footprint
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/published_footprint
    Value: true
  - Alpha: 0.9
    Class: rviz_default_plugins/Polygon
    Color: 255; 80; 80
    Enabled: true
    Name: Collision monitor 1,2 s
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /collision_monitor/footprint_approach
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: VERMELHO eventos
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /diag/eventos
    Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 10
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 180
      Target Frame: base_footprint
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved: null
Window Geometry:
  Displays:
    collapsed: true
  Height: @HEIGHT@
  Hide Left Dock: true
  Hide Right Dock: true
  Width: @WIDTH@
  X: @WIN_X@
  Y: @WIN_Y@
