<root main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">
        <RecoveryNode number_of_retries="1" name="NavigateRecovery">
            <PipelineSequence name="NavigateWithSmacLatticeDWB">
                <RateController hz="1.0">
                    <ComputePathToPose goal="{goal}" path="{path}" planner_id="SmacLattice"/>
                </RateController>
                <FollowPath path="{path}" controller_id="DWBHolonomic" goal_checker_id="position_goal_checker"/>
            </PipelineSequence>
            <Sequence name="ConservativeRecovery">
                <Wait wait_duration="2.0"/>
                <BackUp backup_dist="0.20" backup_speed="0.05"/>
                <Spin spin_dist="1.57"/>
            </Sequence>
        </RecoveryNode>
    </BehaviorTree>
</root>
