<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="SmacLatticeSavitzkyDWB">
        <!-- 2026-07-20: ControllerSelector REMOVIDO. O painel Selector do RViz
             publicava um default != DWB (MPPI), e o MPPI colapsa para ~0 e
             CONGELA o robo. Fixamos DWBHolonomic direto ate o MPPI ser
             consertado. Ver [[mppi-nao-move-investigar]]. -->
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputeAndSmoothRecovery">
            <Sequence name="ComputeAndSmoothPath">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="SmacLattice" error_code_id="{compute_path_error_code}"/>
              <!-- check_for_collisions=false: em corredor apertado o caminho suavizado
                   raspa celulas infladas e a checagem abortava o pipeline inteiro
                   (robo parado em loop de replanejamento). A protecao real contra
                   colisao ja e do controlador + collision_monitor. -->
              <SmoothPath unsmoothed_path="{path}" smoothed_path="{smoothed_path}" smoother_id="savitzky_golay_smoother" max_smoothing_duration="0.2" check_for_collisions="false"/>
            </Sequence>
            <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>

        <RecoveryNode number_of_retries="1" name="FollowPathRecovery">
          <FollowPath path="{smoothed_path}" controller_id="DWBHolonomic" goal_checker_id="general_goal_checker" error_code_id="{follow_path_error_code}"/>
          <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>

      <!-- Recovery de escape (2026-07-20): 1) limpa os costmaps; 2) se ainda
           travado, RE curta de 0.20 m para sair da zona inflada; 3) espera.
           A re vem DEPOIS de limpar o costmap local, entao o BackUp nao ve
           obstaculo-fantasma atras. Spin continua fora (risco de colisao). -->
      <RoundRobin name="EscapeRecoveries">
        <Sequence name="ClearAndBackUp">
          <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
          <BackUp backup_dist="0.20" backup_speed="0.10" time_allowance="20"/>
        </Sequence>
        <Wait wait_duration="1.0"/>
      </RoundRobin>
    </RecoveryNode>
  </BehaviorTree>
</root>
