<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="3" name="NavigateRecovery">
      <PipelineSequence name="SmacLatticeSavitzkyMPPI">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputeAndSmoothRecovery">
            <Sequence name="ComputeAndSmoothPath">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="SmacLattice" error_code_id="{compute_path_error_code}"/>
              <SmoothPath unsmoothed_path="{path}" smoothed_path="{smoothed_path}" smoother_id="savitzky_golay_smoother" max_smoothing_duration="0.2" check_for_collisions="true"/>
            </Sequence>
            <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>

        <RecoveryNode number_of_retries="1" name="FollowPathRecovery">
          <FollowPath path="{smoothed_path}" controller_id="MPPIHolonomic" goal_checker_id="general_goal_checker" error_code_id="{follow_path_error_code}"/>
          <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>

      <RoundRobin name="ConservativeRecoveries">
        <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
        <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
        <Wait wait_duration="1.0"/>
        <BackUp backup_dist="0.15" backup_speed="0.04" time_allowance="6.0"/>
        <Spin spin_dist="1.57" time_allowance="8.0"/>
      </RoundRobin>
    </RecoveryNode>
  </BehaviorTree>
</root>
