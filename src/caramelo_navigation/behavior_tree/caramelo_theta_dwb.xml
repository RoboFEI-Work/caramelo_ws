<root main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">
        <RecoveryNode number_of_retries="1" name="NavigateRecovery">
            <PipelineSequence name="NavigateWithThetaStarDWB">
                <RateController hz="1.0">
                    <ComputePathToPose goal="{goal}" path="{path}" planner_id="ThetaStar"/>
                </RateController>
                <FollowPath path="{path}" controller_id="DWBHolonomic"/>
            </PipelineSequence>
            <!-- RK-05: Spin e BackUp removidos (colisao = -50%). So limpamos e esperamos. -->
            <RoundRobin name="ConservativeRecovery">
                <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
                <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
                <Wait wait_duration="2.0"/>
            </RoundRobin>
        </RecoveryNode>
    </BehaviorTree>
</root>
