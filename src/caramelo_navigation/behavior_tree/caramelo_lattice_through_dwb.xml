<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="3" name="NavigateRecovery">
      <PipelineSequence name="NavigateThroughPosesDWB">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathThroughPosesRecovery">
            <ReactiveSequence name="ComputePathThroughPoses">
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.4"/>
              <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="SmacLattice" error_code_id="{compute_path_error_code}"/>
            </ReactiveSequence>
            <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>

        <RecoveryNode number_of_retries="1" name="FollowPathRecovery">
          <FollowPath path="{path}" controller_id="DWBHolonomic" goal_checker_id="general_goal_checker" error_code_id="{follow_path_error_code}"/>
          <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>

      <!-- RK-05: sem Spin/BackUp (colisao = -50%). O BT default de
           navigate_through_poses do Nav2 usa Spin e QUEBRAVA a ativacao do
           bt_navigator quando o behavior_server deixou de carregar spin/backup
           — este XML substitui aquele default. -->
      <RoundRobin name="ConservativeRecoveries">
        <ClearEntireCostmap service_name="local_costmap/clear_entirely_local_costmap"/>
        <ClearEntireCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
        <Wait wait_duration="1.0"/>
      </RoundRobin>
    </RecoveryNode>
  </BehaviorTree>
</root>
