<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>manip_task_execution</name>
  <version>0.0.0</version>
  <description>Servidores de action /pick_tag, /place_tag e /amt1_sort do braco do Caramelo (MoveGroupInterface + IK propria), com libs puras de IK, fila de alcance, planejador AMT1, superficie livre e estado dos containers.</description>
  <maintainer email="robofei.atwork@gmail.com">Equipe RoboFEI @Work</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>caramelo_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>my_robot_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>control_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>yaml-cpp</depend>

  <!-- URDF/SRDF chegam pelo manip_stack.launch.py (manip_bringup); so runtime. -->
  <exec_depend>manip_moveit_config</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
