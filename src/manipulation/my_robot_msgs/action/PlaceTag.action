string tag_frame
string table_pose
# 2026-08-21: estacao de destino ("WS_3", "SH_1", "PP_1"...). O no de place
# precisa distinguir mesa comum (escolha de slot por camera) de precision
# placement/shelf, e chaveia por estacao a memoria de slots ja usados.
# Vazio = comportamento legado (pose nomeada unica).
string ws
# 2026-08-24: EMPILHAR — frame TF do objeto BASE ja na mesa (ex. "tag_4")
# sobre o qual soltar o objeto carregado. table_pose continua valendo
# (altura da mesa / fallback se a base nao for vista). Vazio = nao empilha.
string stack_on
# 2026-08-25: CONTAINER POR COR — "RED" | "BLUE" = soltar DENTRO do container
# dessa cor visto pela camera na mesa de destino (frames ct_vermelho /
# ct_azul do container_detector). Vazio = mesa. Se o container nao for
# visto, o no faz o place normal na mesa (fallback). Nao combinar com
# stack_on (o executor rejeita).
string container_color

---
bool success
# Auditoria 2026-08-07, item 2.5: skip explicito no contrato — o BT nao
# precisa mais casar substring de message para saber que o objeto foi pulado.
bool skipped
string fail_reason
string message

---
string current_stage
