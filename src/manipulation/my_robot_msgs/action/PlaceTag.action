string tag_frame
string table_pose
# 2026-08-21: estacao de destino ("WS_3", "SH_1", "PP_1"...). O no de place
# precisa distinguir mesa comum (escolha de slot por camera) de precision
# placement/shelf, e chaveia por estacao a memoria de slots ja usados.
# Vazio = comportamento legado (pose nomeada unica).
string ws
# 2026-08-24: EMPILHAR — frame TF do objeto BASE ja na mesa (ex. "tag_4")
# sobre o qual soltar o objeto carregado. table_pose continua valendo
# (altura da mesa / fallback se a base nao for vista). Vazio = nao empilha.
string stack_on
# 2026-08-25: CONTAINER POR COR — "RED" | "BLUE" = soltar DENTRO do container
# dessa cor visto pela camera na mesa de destino (frames ct_vermelho /
# ct_azul do container_detector). Vazio = mesa. Se o container nao for
# visto, o no faz o place normal na mesa (fallback). Nao combinar com
# stack_on (o executor rejeita).
string container_color
# 2026-08-28: FILA DE ALCANCE — tentativa FINAL na estacao? false (default) =
# o executor ainda pode deslocar a base de lado: alvo VISTO mas fora do
# alcance faz o no sair cedo com unreachable=true (sem degraus extras, sem
# varredura, e o place devolve o cubo ao container de bordo). true =
# comportamento de sempre (escada completa + skip / fallback na mesa).
# Ignorado na prateleira (MesaSh).
bool final_attempt
# 2026-08-31: JUNTAS GRAVADAS — se nao vazio (5 valores), o place do stack_on
# vai DIRETO para estas juntas (a configuracao em que a garra fechou na pega
# daquele slot) em vez de resolver a IK do ponto xyz. So vale se a base nao
# se moveu desde a pega (quem chama garante). Vazio = IK normal.
float64[] place_joints

---
bool success
# Auditoria 2026-08-07, item 2.5: skip explicito no contrato — o BT nao
# precisa mais casar substring de message para saber que o objeto foi pulado.
bool skipped
string fail_reason
string message
# 2026-08-28: alvo VISTO mas fora do alcance do braco (so' mesa comum).
bool unreachable
# Deslocamento LATERAL da base sugerido, frame base_footprint (+ = ESQUERDA),
# quantizado em +-{0.10,0.15,0.20,0.25}, verificado pela IK propria.
# 0 = deslocar de lado nao resolve (o executor pula o objeto).
float32 suggested_base_shift_m
# Alvo do TCP que falhou, em manip_base_link (diagnostico).
float32 target_x
float32 target_y

---
string current_stage
