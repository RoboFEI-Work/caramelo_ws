<?xml version="1.0" encoding="UTF-8"?>
<!--
    SRDF do robo COMBINADO Caramelo (base movel + manipulador): a que o
    move_group_caramelo.launch.py e o manip_stack.launch.py carregam. Corresponde
    a URDF de caramelo_description/urdf/robots/robot.urdf.xacro (hardware_ws),
    onde a base do braco se chama "manip_base_link" (filha de base_link via
    manipulator_mount_joint) e a raiz da arvore e base_footprint.
    As poses nomeadas (home, pegar_obj, Mesa*, tag_*, container*) vivem AQUI.
    manip.srdf e a SRDF da bancada standalone (braco sozinho, raiz base_link),
    desatualizada e mantida so para o move_group.launch.py/Setup Assistant.
-->
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="caramelo">
    <!--GROUPS: Representation of a set of joints and links. This can be useful for specifying DOF to plan for, defining arms, end effectors, etc-->
    <!--LINKS: When a link is specified, the parent joint of that link (if it exists) is automatically included-->
    <!--JOINTS: When a joint is specified, the child link of that joint (which will always exist) is automatically included-->
    <!--CHAINS: When a chain is specified, all the links along the chain (including endpoints) are included in the group. Additionally, all the joints that are parents to included links are also included. This means that joints along the chain and the parent joint of the base link are included in the group-->
    <!--SUBGROUPS: Groups can also be formed by referencing to already defined group names-->
    <group name="arm">
        <joint name="manip_joint1"/>
        <joint name="manip_joint2"/>
        <joint name="manip_joint3"/>
        <joint name="manip_joint4"/>
        <joint name="manip_joint5"/>
    </group>
    <group name="gripper">
        <joint name="gripper_base_joint"/>
        <joint name="manip_joint6"/>
        <joint name="manip_joint7"/>
    </group>
    <!--GROUP STATES: Purpose: Define a named state for a particular group, in terms of joint values. This is useful to define states like 'folded arms'-->
    <!-- home: joint3 = 2.10 porque o servo nao aciona alem de ~2.17 rad (Max
         Position Limit na EEPROM; medido 2026-08-10: travava em 2.1717 e toda
         ida ao home dava GOAL_TOLERANCE_VIOLATED). Se quiserem o 2.3911
         original, subir o limite na EEPROM do servo, nao mexer aqui. -->
    <group_state name="home" group="arm">
        <joint name="manip_joint1" value="1.5708"/>
        <joint name="manip_joint2" value="-1.5359"/>
        <joint name="manip_joint3" value="2.10"/>
        <joint name="manip_joint4" value="1.39626"/>
        <joint name="manip_joint5" value="-1.5708"/>
    </group_state>
    <group_state name="pirocao" group="arm">
        <joint name="manip_joint1" value="0.0"/>
        <joint name="manip_joint2" value="0.0"/>
        <joint name="manip_joint3" value="0.0"/>
        <joint name="manip_joint4" value="0.0"/>
        <joint name="manip_joint5" value="0.0"/>
    </group_state>
    <group_state name="pose_1" group="arm">
        <joint name="manip_joint1" value="1.5708"/>
        <joint name="manip_joint2" value="0.0099"/>
        <joint name="manip_joint3" value="1.4796"/>
        <joint name="manip_joint4" value="1.4707"/>
        <joint name="manip_joint5" value="0.0173"/>
    </group_state>
    <group_state name="pose_2" group="arm">
        <joint name="manip_joint1" value="2.6984"/>
        <joint name="manip_joint2" value="0.6265"/>
        <joint name="manip_joint3" value="-0.7613"/>
        <joint name="manip_joint4" value="0.8873"/>
        <joint name="manip_joint5" value="-1.6481"/>
    </group_state>
    <group_state name="pegar_obj" group="arm">
        <joint name="manip_joint1" value="1.5708"/>
        <joint name="manip_joint2" value="-0.3839"/>
        <joint name="manip_joint3" value="1.229"/>
        <joint name="manip_joint4" value="2.19911"/>
        <joint name="manip_joint5" value="-1.567"/>
    </group_state>
    <!-- Pose de partida e retorno do pick em PRATELEIRA (ramo shelf do
         mtc_pick_action_node). Graus: j1 90, j2 -56, j3 134, j4 80, j5 -90.
         Separada do pegar_obj de proposito: aquela e das mesas comuns, ja
         validadas, e nao deve mudar. -->
    <group_state name="pegar_obj_sh" group="arm">
        <joint name="manip_joint1" value="1.570796"/>
        <joint name="manip_joint2" value="-0.977384"/>
        <joint name="manip_joint3" value="2.1642"/>
        <joint name="manip_joint4" value="1.4137"/>
        <joint name="manip_joint5" value="-1.570796"/>
    </group_state>
    <group_state name="tag_cima" group="arm">
        <joint name="manip_joint1" value="1.5708"/>
        <joint name="manip_joint2" value="0.628319"/>
        <joint name="manip_joint3" value="0.837758"/>
        <joint name="manip_joint4" value="1.62316"/>
        <joint name="manip_joint5" value="-1.44862"/>
    </group_state>
    <group_state name="tag_direita" group="arm">
        <joint name="manip_joint1" value="0.9599"/>
        <joint name="manip_joint2" value="0"/>
        <joint name="manip_joint3" value="0.7854"/>
        <joint name="manip_joint4" value="1.9373"/>
        <joint name="manip_joint5" value="-2.1468"/>
    </group_state>
    <group_state name="tag_direita_cima" group="arm">
        <joint name="manip_joint1" value="0.9599"/>
        <joint name="manip_joint2" value="0.698132"/>
        <joint name="manip_joint3" value="0.488692"/>
        <joint name="manip_joint4" value="1.93732"/>
        <joint name="manip_joint5" value="-1.22173"/>
    </group_state>
    <group_state name="tag_esquerda" group="arm">
        <joint name="manip_joint1" value="2.1642"/>
        <joint name="manip_joint2" value="0"/>
        <joint name="manip_joint3" value="0.7854"/>
        <joint name="manip_joint4" value="1.9373"/>
        <joint name="manip_joint5" value="-1.2217"/>
    </group_state>
    <group_state name="tag_esquerda_cima" group="arm">
        <joint name="manip_joint1" value="2.1642"/>
        <joint name="manip_joint2" value="0.698132"/>
        <joint name="manip_joint3" value="0.488692"/>
        <joint name="manip_joint4" value="1.93732"/>
        <joint name="manip_joint5" value="-1.22173"/>
    </group_state>
    <group_state name="pre_container" group="arm">
        <joint name="manip_joint1" value="-1.5708"/>
        <joint name="manip_joint2" value="0.0"/>
        <joint name="manip_joint3" value="1.0821"/>
        <joint name="manip_joint4" value="1.8151"/>
        <joint name="manip_joint5" value="1.5708"/>
    </group_state>
    <group_state name="container1" group="arm">
        <joint name="manip_joint1" value="-1.13446"/>
        <joint name="manip_joint2" value="0.20944"/>
        <joint name="manip_joint3" value="1.43117"/>
        <joint name="manip_joint4" value="1.39626"/>
        <joint name="manip_joint5" value="-1.01229"/>
    </group_state>
    <group_state name="container2" group="arm">
        <joint name="manip_joint1" value="-1.58825"/>
        <joint name="manip_joint2" value="0.0"/>
        <joint name="manip_joint3" value="1.67552"/>
        <joint name="manip_joint4" value="1.27409"/>
        <joint name="manip_joint5" value="-1.64061"/>
    </group_state>
    <group_state name="container3" group="arm">
        <joint name="manip_joint1" value="-1.97222"/>
        <joint name="manip_joint2" value="0.08727"/>
        <joint name="manip_joint3" value="1.55334"/>
        <joint name="manip_joint4" value="1.3439"/>
        <joint name="manip_joint5" value="-1.8675"/>
    </group_state>
    <group_state name="Mesa0" group="arm">
        <joint name="manip_joint1" value="1.5708"/>
        <joint name="manip_joint2" value="0.9599"/>
        <joint name="manip_joint3" value="1.0297"/>
        <joint name="manip_joint4" value="0.9948"/>
        <joint name="manip_joint5" value="-1.5708"/>
    </group_state>
    <group_state name="Mesa0.1" group="arm">
        <joint name="manip_joint1" value="0.8029"/>
        <joint name="manip_joint2" value="0.9599"/>
        <joint name="manip_joint3" value="1.0297"/>
        <joint name="manip_joint4" value="0.9948"/>
        <joint name="manip_joint5" value="-1.5708"/>
    </group_state>
    <group_state name="Mesa0.2" group="arm">
        <joint name="manip_joint1" value="2.0944"/>
        <joint name="manip_joint2" value="0.9599"/>
        <joint name="manip_joint3" value="1.0297"/>
        <joint name="manip_joint4" value="0.9948"/>
        <joint name="manip_joint5" value="-1.5708"/>
    </group_state>
    <group_state name="Mesa5" group="arm">
        <joint name="manip_joint1" value="1.4835"/>
        <joint name="manip_joint2" value="1.0123"/>
        <joint name="manip_joint3" value="0.5934"/>
        <joint name="manip_joint4" value="1.3788"/>
        <joint name="manip_joint5" value="-1.6581"/>
    </group_state>
    <group_state name="Mesa5.1" group="arm">
        <joint name="manip_joint1" value="1.9373"/>
        <joint name="manip_joint2" value="1.0123"/>
        <joint name="manip_joint3" value="0.5934"/>
        <joint name="manip_joint4" value="1.3788"/>
        <joint name="manip_joint5" value="-1.6581"/>
    </group_state>
    <group_state name="Mesa5.2" group="arm">
        <joint name="manip_joint1" value="0.9425"/>
        <joint name="manip_joint2" value="1.0123"/>
        <joint name="manip_joint3" value="0.5934"/>
        <joint name="manip_joint4" value="1.3788"/>
        <joint name="manip_joint5" value="-1.6581"/>
    </group_state>
    <group_state name="Mesa10" group="arm">
        <joint name="manip_joint1" value="1.5708"/>
        <joint name="manip_joint2" value="0.5760"/>
        <joint name="manip_joint3" value="1.1519"/>
        <joint name="manip_joint4" value="1.1694"/>
        <joint name="manip_joint5" value="-1.5708"/>
    </group_state>
    <group_state name="Mesa10.1" group="arm">
        <joint name="manip_joint1" value="1.0123"/>
        <joint name="manip_joint2" value="0.9774"/>
        <joint name="manip_joint3" value="0.5585"/>
        <joint name="manip_joint4" value="1.4835"/>
        <joint name="manip_joint5" value="-1.5882"/>
    </group_state>
    <group_state name="Mesa10.2" group="arm">
        <joint name="manip_joint1" value="2.1991"/>
        <joint name="manip_joint2" value="1.0123"/>
        <joint name="manip_joint3" value="0.4712"/>
        <joint name="manip_joint4" value="1.4137"/>
        <joint name="manip_joint5" value="-1.6057"/>
    </group_state>
    <group_state name="Mesa15" group="arm">
        <joint name="manip_joint1" value="1.5708"/>
        <joint name="manip_joint2" value="0.6458"/>
        <joint name="manip_joint3" value="0.7854"/>
        <joint name="manip_joint4" value="1.6406"/>
        <joint name="manip_joint5" value="-1.5708"/>
    </group_state>
    <!-- Mesa15.1 = simetrica da Mesa15.2 (j1 = 1.5708 - 0.4887; j2..j5 iguais
         a Mesa15), gravada 2026-08-21 no lugar da familia "de costas" (girava
         o joint1 ~201 graus com bloco na garra). FK esperada em
         base_footprint: (0.536, -0.170, 0.208). VALIDAR NO ROBO antes da prova. -->
    <group_state name="Mesa15.1" group="arm">
        <joint name="manip_joint1" value="1.0821"/>
        <joint name="manip_joint2" value="0.6458"/>
        <joint name="manip_joint3" value="0.7854"/>
        <joint name="manip_joint4" value="1.6406"/>
        <joint name="manip_joint5" value="-1.5708"/>
    </group_state>
    <group_state name="Mesa15.2" group="arm">
        <joint name="manip_joint1" value="2.0595"/>
        <joint name="manip_joint2" value="0.6458"/>
        <joint name="manip_joint3" value="0.7854"/>
        <joint name="manip_joint4" value="1.6406"/>
        <joint name="manip_joint5" value="-1.5708"/>
    </group_state>
    <group_state name="MesaSh" group="arm">
        <joint name="manip_joint1" value="1.44862"/>
        <joint name="manip_joint2" value="0.890118"/>
        <joint name="manip_joint3" value="-0.436332"/>
        <joint name="manip_joint4" value="1.93732"/>
        <joint name="manip_joint5" value="-1.44862"/>
    </group_state>
    <group_state name="gripper_close" group="gripper">
        <joint name="manip_joint6" value="0.170"/>
        <joint name="manip_joint7" value="0.170"/>
    </group_state>
    <group_state name="gripper_open" group="gripper">
        <joint name="manip_joint6" value="-0.2265"/>
        <joint name="manip_joint7" value="-0.2265"/>
    </group_state>
    <group_state name="gripper_full_open" group="gripper">
        <joint name="manip_joint6" value="-0.994838"/>
        <joint name="manip_joint7" value="-0.994838"/>
    </group_state>
    <!--END EFFECTOR: Purpose: Represent information about an end effector.-->
    <end_effector name="gripper" parent_link="link5" group="gripper" parent_group="arm"/>
    <!--VIRTUAL JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame of reference (considered fixed with respect to the robot)-->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_footprint"/>
    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <!--Braco: pares originais da manip.srdf. Na URDF combinada a base do braco e "manip_base_link" (na standalone chamava-se "base_link").-->
    <disable_collisions link1="manip_base_link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="manip_base_link" link2="link2" reason="Never"/>
    <disable_collisions link1="finger_left" link2="finger_right" reason="Adjacent"/>
    <disable_collisions link1="finger_left" link2="camera_link" reason="Never"/>
    <disable_collisions link1="finger_left" link2="link3" reason="Never"/>
    <disable_collisions link1="finger_left" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="finger_right" link2="camera_link" reason="Never"/>
    <disable_collisions link1="finger_right" link2="link3" reason="Never"/>
    <disable_collisions link1="finger_right" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="camera_link" link2="link3" reason="Never"/>
    <disable_collisions link1="camera_link" link2="link4" reason="Never"/>
    <disable_collisions link1="camera_link" link2="link5" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
    <!-- Pares abaixo desabilitados em bloco porque as malhas de colisao do
         braco sao superdimensionadas: com o braco reto para cima (pirocao)
         o /check_state_validity acusava 10 contatos impossiveis e rejeitava
         qualquer plano (medido 2026-08-15). A protecao real sao as poses
         validadas no robo e os limites de junta (j3 <= 2.6); se as malhas
         forem remodeladas no tamanho certo, reavaliar este bloco. -->
    <disable_collisions link1="link2" link2="link4" reason="Never"/>
    <disable_collisions link1="link2" link2="link5" reason="Never"/>
    <disable_collisions link1="link1" link2="link3" reason="Never"/>
    <disable_collisions link1="link1" link2="link4" reason="Never"/>
    <disable_collisions link1="link1" link2="link5" reason="Never"/>
    <disable_collisions link1="manip_base_link" link2="link3" reason="Never"/>
    <disable_collisions link1="manip_base_link" link2="link4" reason="Never"/>
    <disable_collisions link1="manip_base_link" link2="link5" reason="Never"/>
    <disable_collisions link1="base_link" link2="link4" reason="Never"/>
    <disable_collisions link1="base_link" link2="link5" reason="Never"/>
    <disable_collisions link1="link3" link2="link5" reason="Never"/>
    <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
    <!--Chassi (base_link) x braco: apenas manip_base_link (Adjacent via manipulator_mount_joint) e link1 (nunca alcanca o chassi).
        NAO desabilitar base_link x link4/link5/fingers/camera_link: sao colisoes REAIS que o MoveIt deve evitar.-->
    <disable_collisions link1="base_link" link2="manip_base_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="link1" reason="Never"/>
    <!--Com colisao PRIMITIVE (caixas envolventes), link2/link3 dobrados sobre o
        chassi em home interpenetram ~1-2cm onde as malhas reais tem folga (falso
        positivo de bounding); a protecao do chassi segue nos pares ativos
        link4/link5/fingers/camera.-->
    <disable_collisions link1="base_link" link2="link2" reason="Default"/>
    <disable_collisions link1="base_link" link2="link3" reason="Default"/>
    <!--Mesmo falso positivo de bounding com as RODAS (pre_container->home raspava
        a caixa da back_left_wheel e derrubava a missao, 2026-08-07): link2/link3
        nunca alcancam as rodas, a chapa do chassi esta no meio; a protecao real
        segue nos pares ATIVOS de base_link x link4/link5/fingers/camera.-->
    <disable_collisions link1="link2" link2="front_left_wheel_link" reason="Never"/>
    <disable_collisions link1="link2" link2="front_right_wheel_link" reason="Never"/>
    <disable_collisions link1="link2" link2="back_left_wheel_link" reason="Never"/>
    <disable_collisions link1="link2" link2="back_right_wheel_link" reason="Never"/>
    <disable_collisions link1="link3" link2="front_left_wheel_link" reason="Never"/>
    <disable_collisions link1="link3" link2="front_right_wheel_link" reason="Never"/>
    <disable_collisions link1="link3" link2="back_left_wheel_link" reason="Never"/>
    <disable_collisions link1="link3" link2="back_right_wheel_link" reason="Never"/>
    <!--Rodas x chassi: fixas ao chassi pelos wheel_joints (Adjacent).-->
    <disable_collisions link1="base_link" link2="front_left_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="front_right_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="back_left_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="back_right_wheel_link" reason="Adjacent"/>
    <!--Rodas entre si: posicao relativa fixa via chassi, jamais colidem.-->
    <disable_collisions link1="front_left_wheel_link" link2="front_right_wheel_link" reason="Never"/>
    <disable_collisions link1="front_left_wheel_link" link2="back_left_wheel_link" reason="Never"/>
    <disable_collisions link1="front_left_wheel_link" link2="back_right_wheel_link" reason="Never"/>
    <disable_collisions link1="front_right_wheel_link" link2="back_left_wheel_link" reason="Never"/>
    <disable_collisions link1="front_right_wheel_link" link2="back_right_wheel_link" reason="Never"/>
    <disable_collisions link1="back_left_wheel_link" link2="back_right_wheel_link" reason="Never"/>
    <!--Rodas x base do braco e x link1: geometrias nunca se alcancam.-->
    <disable_collisions link1="front_left_wheel_link" link2="manip_base_link" reason="Never"/>
    <disable_collisions link1="front_right_wheel_link" link2="manip_base_link" reason="Never"/>
    <disable_collisions link1="back_left_wheel_link" link2="manip_base_link" reason="Never"/>
    <disable_collisions link1="back_right_wheel_link" link2="manip_base_link" reason="Never"/>
    <disable_collisions link1="front_left_wheel_link" link2="link1" reason="Never"/>
    <disable_collisions link1="front_right_wheel_link" link2="link1" reason="Never"/>
    <disable_collisions link1="back_left_wheel_link" link2="link1" reason="Never"/>
    <disable_collisions link1="back_right_wheel_link" link2="link1" reason="Never"/>
</robot>
