<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>manip_bringup</name>
  <version>0.0.0</version>
  <description>Stack de manipulacao do PC (manip_stack.launch.py): move_group, pick/place MTC, RealSense, AprilTag, detectores de container e superficie, voz e braco mock.</description>
  <maintainer email="robofei.atwork@gmail.com">Equipe RoboFEI @Work</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>manip_moveit_config</exec_depend>
  <exec_depend>manip_commander</exec_depend>
  <!-- camera e deteccao de tags (manip_stack.launch.py) -->
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>apriltag_ros</exec_depend>
  <exec_depend>apriltag_msgs</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>manip_task_execution</exec_depend>
  <exec_depend>my_robot_msgs</exec_depend>
  <exec_depend>manip_audio</exec_depend>
  <!-- manip_stack.launch.py roda o xacro do robo completo no modo mock -->
  <exec_depend>caramelo_description</exec_depend>
  <!-- perception_gate_node.py -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <!-- container_detector_node.py -->
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- workstation_surface_node.py / vision_debug_node.py (grade, poligono do tampo, retas de borda) -->
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
