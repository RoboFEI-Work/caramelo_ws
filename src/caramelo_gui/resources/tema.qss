/* Tema Caramelo x RoboFEI — navy escuro do logo RoboFEI, ciano de destaque e
   laranja Caramelo na acao primaria. Cartoes grandes, alto contraste, hover
   reativo (estilo apps de tecnologia). */

QMainWindow, QWidget {
  background: #0b1626;               /* navy RoboFEI */
  color: #e6f1ff;
  font-family: "Noto Sans", "DejaVu Sans", sans-serif;
  font-size: 14px;
}

/* ---------- Sidebar de modulos ---------- */
QListWidget#sidebar {
  background: #081120;
  border: none;
  border-right: 1px solid #14294a;
  outline: 0;
  padding-top: 10px;
}
QListWidget#sidebar::item {
  padding: 13px 18px;
  margin: 3px 10px;
  border-radius: 12px;
  color: #7d9cc4;
}
QListWidget#sidebar::item:hover {
  background: #12233f;
  color: #bfe3ff;
}
QListWidget#sidebar::item:selected {
  background: #103154;
  color: #35c3f0;                    /* ciano RoboFEI */
  border-left: 3px solid #35c3f0;
  font-weight: 700;
}
QListWidget#sidebar::item:disabled {
  color: #33507a;
}

/* ---------- Faixa superior (unica regiao permanente da tela) ---------- */
QWidget#faixaSuperior {
  background: #081120;
  border-bottom: 1px solid #14294a;
}
QLabel#tituloFaixa {
  font-size: 19px;
  font-weight: 800;
  color: #ffffff;
  padding-left: 8px;
}
QLabel#infoFaixa {
  color: #a9c6e8;
  font-weight: 600;
  padding: 4px 12px;
}
QLabel#estadoFaixa {
  font-weight: 800;
  color: #06121f;
  background: #35c3f0;
  border-radius: 10px;
  padding: 5px 14px;
  margin-right: 8px;
}
QPushButton#botaoVoltar { font-size: 15px; font-weight: 700; }

/* ---------- Menu principal (layout de robo de servico) ---------- */

/* Coluna do robo, a esquerda */
QFrame#colunaRobo {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #14284a, stop:1 #0e1c31);
  border: 1px solid #1b3457;
  border-radius: 20px;
}
QLabel#nomeRobo   { font-size: 30px; font-weight: 800; color: #ffffff; }
QLabel#equipeRobo { font-size: 14px; color: #7d9cc4; }
QLabel#chipEstadoRobo {
  font-size: 14px;
  font-weight: 700;
  color: #06121f;
  background: #35c3f0;
  border-radius: 10px;
  padding: 8px 12px;
}
QLabel#arenaRobo { font-size: 14px; color: #a9c6e8; padding-top: 4px; }

/* Cartao de ACAO: grande, alvo de toque generoso, e o estado dentro dele. */
QFrame#cartaoHome {
  background: #101e35;
  border: 1px solid #1b3457;
  border-radius: 20px;
}
QFrame#cartaoHome:hover {
  background: #16294a;
  border: 1px solid #35c3f0;
}
QLabel#tituloCartaoHome { font-size: 21px; font-weight: 800; color: #ffffff; }
QLabel#subCartaoHome    { font-size: 13px; color: #8fb0d8; }
QLabel#chipEstado       { font-size: 11px; font-weight: 800; }
QLabel#motivoCartao     { font-size: 12px; color: #ffd28f; }

/* Barra de acoes rapidas, embaixo */
QFrame#barraInferior {
  background: #081120;
  border: 1px solid #14294a;
  border-radius: 16px;
}
QPushButton#acaoRapida {
  background: transparent;
  border: none;
  color: #cfe4fb;
  font-size: 15px;
  font-weight: 700;
  padding: 8px 18px;
}
QPushButton#acaoRapida:hover    { background: #12233f; border-radius: 12px; }
QPushButton#acaoRapida:disabled { color: #40597d; }
QPushButton#acaoParar {
  background: transparent;
  border: none;
  color: #ff9d9d;
  font-size: 15px;
  font-weight: 800;
  padding: 8px 18px;
}
QPushButton#acaoParar:hover { background: #3a1620; border-radius: 12px; }
QLabel#motivoBarra { font-size: 12px; color: #6d86a8; }

/* ---------- Abas de contexto ---------- */
QListWidget#abasContexto {
  background: #081120;
  border: none;
  border-right: 1px solid #14294a;
  border-radius: 0;
  outline: 0;
  padding-top: 8px;
}
QListWidget#abasContexto::item {
  padding: 13px 16px;
  margin: 3px 8px;
  border-radius: 12px;
  color: #7d9cc4;
}
QListWidget#abasContexto::item:hover    { background: #12233f; color: #bfe3ff; }
QListWidget#abasContexto::item:selected {
  background: #103154;
  color: #35c3f0;
  font-weight: 700;
}

/* ---------- Titulos e textos ---------- */
QLabel#tituloModulo {
  font-size: 21px;
  font-weight: 800;
  color: #ffffff;
  padding: 8px 4px;
  letter-spacing: 0.5px;
}
QLabel#tituloCartao { font-size: 16px; font-weight: 700; color: #dcecff; }
QLabel#msgCartao    { color: #8fb0d8; }
QLabel#detalheCartao{ color: #5f7ea8; font-size: 12px; }

/* ---------- Cartoes de status ---------- */
QFrame#cartaoStatus {
  background: #101e35;
  border: 1px solid #1b3457;
  border-radius: 16px;
  padding: 14px;
}
QFrame#cartaoStatus:hover {
  background: #142643;
  border: 1px solid #35c3f0;
}

/* ---------- Botoes ---------- */
QPushButton {
  background: #142643;
  color: #dcecff;
  border: 1px solid #1f3a5f;
  border-radius: 12px;
  padding: 10px 16px;
  font-weight: 600;
}
QPushButton:hover  { background: #1b3457; border-color: #35c3f0; color: #ffffff; }
QPushButton:pressed{ background: #0f1e36; }
QPushButton:checked{ background: #103154; border-color: #35c3f0; color: #35c3f0; }
QPushButton:disabled{ color: #3d5a82; border-color: #14294a; }

/* Acao primaria = laranja Caramelo */
QPushButton#acaoPrimaria {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #ff9a2e, stop:1 #f07f0e);
  color: #1a0e00;
  border: none;
  font-weight: 800;
}
QPushButton#acaoPrimaria:hover  { background: #ffab4d; }
QPushButton#acaoPrimaria:pressed{ background: #e0760c; }

/* ---------- Formularios ---------- */
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox {
  background: #0e1c31;
  color: #e6f1ff;
  border: 1px solid #1f3a5f;
  border-radius: 10px;
  padding: 8px 10px;
  selection-background-color: #35c3f0;
  selection-color: #06121f;
}
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus {
  border: 1px solid #35c3f0;
}
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView {
  background: #101e35; color: #e6f1ff;
  selection-background-color: #103154; border: 1px solid #1f3a5f;
}

QCheckBox { color: #a9c6e8; spacing: 8px; }
QCheckBox::indicator {
  width: 18px; height: 18px; border-radius: 5px;
  border: 1px solid #2a4a75; background: #0e1c31;
}
QCheckBox::indicator:hover   { border-color: #35c3f0; }
QCheckBox::indicator:checked { background: #35c3f0; border-color: #35c3f0; }

/* ---------- Sliders ---------- */
QSlider::groove:horizontal {
  height: 6px; background: #14294a; border-radius: 3px;
}
QSlider::sub-page:horizontal { background: #35c3f0; border-radius: 3px; }
QSlider::handle:horizontal {
  width: 18px; height: 18px; margin: -7px 0;
  border-radius: 9px; background: #ffffff;
}
QSlider::handle:horizontal:hover { background: #35c3f0; }

/* ---------- Listas ---------- */
QListWidget {
  background: #0e1c31;
  border: 1px solid #1b3457;
  border-radius: 12px;
  padding: 6px;
}
QListWidget::item { padding: 8px; border-radius: 8px; color: #cfe4fb; }
QListWidget::item:hover    { background: #142643; }
QListWidget::item:selected { background: #103154; color: #35c3f0; }

/* ---------- Barra de estado ---------- */
QStatusBar { background: #081120; border-top: 1px solid #14294a; }
QLabel#estadoAtual {
  font-weight: 800;
  color: #06121f;
  background: #35c3f0;
  border-radius: 10px;
  padding: 4px 14px;
}
QLabel#bateriaLabel {
  color: #ffd28f;
  font-weight: 700;
  padding: 2px 10px;
}

/* ---------- Painel de logs (oculto por padrao) ---------- */
QPlainTextEdit#painelLogs {
  background: #050d18;
  color: #7fe3a8;
  border-top: 1px solid #14294a;
  font-family: "JetBrains Mono", "DejaVu Sans Mono", monospace;
  font-size: 12px;
}

QScrollArea { background: transparent; border: none; }
QScrollBar:vertical {
  background: #0b1626; width: 10px; border-radius: 5px;
}
QScrollBar::handle:vertical {
  background: #1f3a5f; border-radius: 5px; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #35c3f0; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

/* ==========================================================================
   FERRAMENTA DE MAPEAMENTO — trilho de etapas, controle segmentado e o
   arranjo "mapa no centro, controles a direita".

   Por que trilho e nao abas: mapear tem ordem obrigatoria (mapear, limpar
   ruido, marcar pontos, paredes virtuais). Abas sao todas iguais entre si e
   nao contam nada sobre ordem -- quem nunca usou o robo clicava na terceira
   antes da primeira e nao entendia por que nao funcionava. O trilho mostra
   tres estados diferentes (feita, atual, travada) e a travada explica o
   motivo em texto, no lugar de so' ficar cinza.
   ========================================================================== */

QFrame#trilhoEtapas {
  background: #081120;
  border-right: 1px solid #14294a;
  min-width: 250px;
  max-width: 250px;
}

/* Uma etapa e' um botao (clicavel quando ja' foi feita, para voltar), e o
   estado vem de uma propriedade Qt -- setProperty("estado", "feita") e um
   unpolish/polish para reaplicar. Assim o widget nao precisa saber cor
   nenhuma: ele so' diz em que estado esta'. */
QPushButton#etapaTrilho {
  background: transparent;
  border: none;
  border-left: 3px solid transparent;
  text-align: left;
  padding: 14px 16px;
  font-size: 14px;
  font-weight: 700;
  color: #7d9cc4;
}
QPushButton#etapaTrilho[estado="feita"] {
  color: #a9c6e8;
  border-left-color: #27ae60;
}
QPushButton#etapaTrilho[estado="feita"]:hover {
  background: #0e1c31;
}
QPushButton#etapaTrilho[estado="atual"] {
  color: #ffffff;
  background: #101e35;
  border-left-color: #35c3f0;
}
QPushButton#etapaTrilho[estado="travada"] {
  color: #40597d;
}

/* O numero da etapa, no circulo a esquerda do nome. */
QLabel#numeroEtapa {
  min-width: 26px; max-width: 26px;
  min-height: 26px; max-height: 26px;
  border-radius: 13px;
  font-size: 13px;
  font-weight: 800;
  qproperty-alignment: AlignCenter;
  background: #16294a;
  color: #7d9cc4;
}
QLabel#numeroEtapa[estado="feita"]   { background: #27ae60; color: #04180c; }
QLabel#numeroEtapa[estado="atual"]   { background: #35c3f0; color: #04121c; }
QLabel#numeroEtapa[estado="travada"] { background: #16294a; color: #40597d; }

/* A frase que explica por que a etapa esta' travada. Nunca deixar so' o
   cinza do disabled: cinza sem motivo lê como "quebrado". */
QLabel#motivoEtapa {
  color: #ffd28f;
  font-size: 12px;
  padding: 0 16px 12px 45px;
}

/* ---------- Controle segmentado (as duas formas de marcar um ponto) ------ */
/* Duas opcoes lado a lado, sempre as DUAS visiveis. Um combo esconderia a
   segunda atras de um clique, e a escolha entre "marcar no mapa" e "levar o
   robo ate la'" e' justamente o que o operador precisa enxergar de uma vez. */
QFrame#segmentado {
  background: #0e1c31;
  border: 1px solid #1f3a5f;
  border-radius: 12px;
}
QPushButton#segmento {
  background: transparent;
  border: none;
  border-radius: 10px;
  padding: 12px 10px;
  font-size: 13px;
  font-weight: 700;
  color: #7d9cc4;
  margin: 3px;
}
QPushButton#segmento:hover   { color: #dcecff; }
QPushButton#segmento:checked {
  background: #123a56;
  color: #dff0ff;
}

/* ---------- Mapa no centro, controles a direita ---------- */
/* O mapa e' o objeto de trabalho: ganha o espaco. O painel tem largura fixa
   porque campo de formulario que estica fica ridiculo em tela cheia. */
QFrame#molduraMapa {
  background: #101e35;
  border: 1px solid #1b3457;
  border-radius: 16px;
}
QFrame#painelControle {
  background: #101e35;
  border: 1px solid #1b3457;
  border-radius: 16px;
  min-width: 330px;
  max-width: 330px;
}
QLabel#tituloPainel {
  color: #7d9cc4;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1px;
  padding-bottom: 6px;
}

/* Dica de gesto, embaixo do mapa: "clique e arraste para dizer a direcao". */
QLabel#dicaGesto {
  color: #7d9cc4;
  font-size: 12px;
  padding: 6px 4px;
}

/* ---------- Acao primaria e destrutiva ---------- */
/* Laranja Caramelo so' na acao que faz a etapa avancar; uma por tela. */
QPushButton#acaoPrimaria {
  background: #ff9a2e;
  color: #2b1600;
  border: none;
  border-radius: 12px;
  padding: 14px 18px;
  font-size: 15px;
  font-weight: 800;
}
QPushButton#acaoPrimaria:hover    { background: #f07f0e; }
QPushButton#acaoPrimaria:disabled { background: #3a2e1c; color: #7a6a52; }

QPushButton#acaoDestrutiva {
  background: #3a1420;
  color: #ffd7de;
  border: 1px solid #7d2440;
  border-radius: 12px;
  padding: 12px 16px;
  font-weight: 700;
}
QPushButton#acaoDestrutiva:hover { background: #4d1a2a; }

/* ---------- Listas de opcoes validas (o fim dos campos de texto livre) --- */
QComboBox {
  background: #0e1c31;
  border: 1px solid #1f3a5f;
  border-radius: 10px;
  padding: 10px 12px;
  font-size: 14px;
  font-weight: 600;
  min-height: 20px;
}
QComboBox:hover    { border-color: #35c3f0; }
QComboBox:disabled { color: #40597d; background: #0a1424; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView {
  background: #101e35;
  border: 1px solid #1f3a5f;
  border-radius: 10px;
  selection-background-color: #123a56;
  outline: none;
  padding: 4px;
}
