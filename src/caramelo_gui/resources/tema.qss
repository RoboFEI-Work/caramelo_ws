/* Tema PUDU do Caramelo: limpo, claro, cartoes grandes, alto contraste. */

QMainWindow, QWidget {
  background: #f4f6f8;
  color: #1f2933;
  font-family: "Noto Sans", "DejaVu Sans", sans-serif;
  font-size: 14px;
}

/* Sidebar de modulos */
QListWidget#sidebar {
  background: #ffffff;
  border: none;
  border-right: 1px solid #e0e4e8;
  outline: 0;
  padding-top: 8px;
}
QListWidget#sidebar::item {
  padding: 12px 18px;
  margin: 2px 8px;
  border-radius: 10px;
  color: #52606d;
}
QListWidget#sidebar::item:selected {
  background: #e3f2fd;
  color: #0b6bcb;
  font-weight: 600;
}
QListWidget#sidebar::item:disabled {
  color: #b0b8c1;
}

/* Titulos */
QLabel#tituloModulo {
  font-size: 22px;
  font-weight: 700;
  color: #102a43;
  padding: 8px 4px;
}
QLabel#tituloCartao {
  font-size: 16px;
  font-weight: 600;
}
QLabel#msgCartao {
  color: #52606d;
}
QLabel#detalheCartao {
  color: #7b8794;
  font-size: 12px;
}

/* Cartoes de status */
QFrame#cartaoStatus {
  background: #ffffff;
  border: 1px solid #e0e4e8;
  border-radius: 14px;
  padding: 12px;
}

/* Barra de estado */
QLabel#estadoAtual {
  font-weight: 600;
  color: #0b6bcb;
  padding: 2px 10px;
}

QCheckBox {
  color: #52606d;
}
QScrollArea {
  background: transparent;
}
