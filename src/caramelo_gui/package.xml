<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>caramelo_gui</name>
  <version>0.1.0</version>
  <description>Interface grafica Qt5/C++ com RViz embutido para operar o Caramelo pelo PC: menu inicial, operacao (navegacao, docking, localizacao, teleop, waypoints), competicao (missao via /caramelo/run_mission), mapas, ferramenta de mapeamento e modo avancado (saude, sensores, service areas).</description>
  <maintainer email="robofei.atwork@gmail.com">Equipe RoboFEI @Work</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>ament_index_cpp</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>interactive_markers</depend>
  <depend>tf2_ros</depend>
  <depend>yaml-cpp</depend>
  <depend>nav2_msgs</depend>
  <depend>caramelo_msgs</depend>
  <depend>rviz_common</depend>
  <depend>rviz_rendering</depend>
  <depend>rviz_default_plugins</depend>
  <depend>qtbase5-dev</depend>

  <exec_depend>caramelo_diagnostics</exec_depend>
  <!-- mission_server.launch.py (tela Competicao), bringup/slam por QProcess e os
       scripts de service areas/docking chamados pela Ferramenta de Mapeamento. -->
  <exec_depend>caramelo_navigation</exec_depend>
  <exec_depend>caramelo_mapping</exec_depend>
  <exec_depend>caramelo_utils</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
