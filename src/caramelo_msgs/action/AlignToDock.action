# Alinhamento fino HOLONOMICO a um dock (ADR-05 opcao c), servido pelo
# dock_align_node (nome relativo 'align_to_dock'). Complementa o opennav_docking
# (cujo controller e' unicycle e nao usa vy). Deve ser chamado DEPOIS do
# staging do Docking Server: ajuste lateral pela face no /scan, reto guiado
# pelo muro LiDAR ate a distancia de parada e retoque lateral na mesa (v5).

# --- Goal ---
string dock_id            # ID do dock no docking.yaml do mapa (ex.: WS1, SH1, PP1)
string map_name           # pasta do mapa em caramelo_mapping/maps/
string map_dir            # opcional: raiz dos mapas (vazio => resolve sozinho)
float64 xy_tolerance      # tolerancia final XY em metros (0 => default do no)
float64 yaw_tolerance     # tolerancia final de yaw em rad (0 => default do no)
bool use_lidar_refine     # tenta refinar a pose alvo pelos cantos da mesa no /scan
float64 timeout           # tempo maximo em s (0 => default do no)
---
# --- Result ---
bool success
string message
float64 final_x_error
float64 final_y_error
float64 final_yaw_error
---
# --- Feedback ---
string phase              # fases reais publicadas pelo no': "refinando" (fit da face),
                          # "esquadrando" (giro por AMCL sem face), "centrando" (lateral),
                          # "aproximando" (reto), "assentando", "recuando",
                          # "sem_scan" / "face_invisivel" (parado esperando o muro)
float64 x_error
float64 y_error
float64 yaw_error
