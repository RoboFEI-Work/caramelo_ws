dock_plugins:
  caramelo_front_dock:
    plugin: opennav_docking::SimpleNonChargingDock
    docking_threshold: 0.05
    staging_x_offset: -0.7
    staging_yaw_offset: 0.0
    dock_direction: forward
    rotate_to_dock: false
    use_external_detection_pose: false
    use_battery_status: false
    use_stall_detection: false
  caramelo_precision_front_dock:
    plugin: opennav_docking::SimpleNonChargingDock
    docking_threshold: 0.03
    staging_x_offset: -0.8
    staging_yaw_offset: 0.0
    dock_direction: forward
    rotate_to_dock: false
    use_external_detection_pose: false
    use_battery_status: false
    use_stall_detection: false
  caramelo_shelf_front_dock:
    plugin: opennav_docking::SimpleNonChargingDock
    docking_threshold: 0.06
    staging_x_offset: -0.9
    staging_yaw_offset: 0.0
    dock_direction: forward
    rotate_to_dock: false
    use_external_detection_pose: false
    use_battery_status: false
    use_stall_detection: false
docks:
  START:
    type: caramelo_front_dock
    frame: map
    pose:
    - 0.0
    - 0.0
    - 0.0
    id: START
  FINISH:
    type: caramelo_front_dock
    frame: map
    pose:
    - 0.0
    - 0.0
    - 0.0
    id: FINISH
  WS1:
    type: caramelo_front_dock
    frame: map
    pose:
    - 1.4622
    - -2.1941
    - -0.073313
    id: WS1
  WS2:
    type: caramelo_front_dock
    frame: map
    pose:
    - 0.1921
    - -3.1004
    - 2.920988
    id: WS2
  WS3:
    type: caramelo_front_dock
    frame: map
    pose:
    - 0.0
    - 0.0
    - 0.0
    id: WS3
  WS4:
    type: caramelo_front_dock
    frame: map
    pose:
    - 0.0
    - 0.0
    - 0.0
    id: WS4
  SH1:
    type: caramelo_shelf_front_dock
    frame: map
    pose:
    - 0.0
    - 0.0
    - 0.0
    id: SH1
  PP1:
    type: caramelo_precision_front_dock
    frame: map
    pose:
    - 0.0
    - 0.0
    - 0.0
    id: PP1
  RT1:
    type: caramelo_precision_front_dock
    frame: map
    pose:
    - 0.0
    - 0.0
    - 0.0
    id: RT1
