service_areas:
  START:
    type: start
    frame_id: map
    final_robot_pose:
      x: 0.0
      y: 0.0
      yaw: 0.0
    docking:
      approach_offset: 0.0
      linear_tolerance: 0.05
      angular_tolerance: 0.05
      use_docking: false
    manipulation_enabled: false
    notes: START - pose inicial do robo.
    kind: START
    dock_id: START
    approach: front
