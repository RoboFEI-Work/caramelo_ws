docks:
  WS1:
    type: caramelo_front_dock
    frame: map
    pose:
    - 0.8836
    - -2.9635
    - 3.115846
    id: WS1
  WS2:
    type: caramelo_front_dock
    frame: map
    pose:
    - 1.5927
    - -0.987
    - 3.132785
    id: WS2
  WS3:
    type: caramelo_ws3_dock
    frame: map
    pose:
    - 0.0
    - 0.0
    - 0.0
    id: WS3
  WS4:
