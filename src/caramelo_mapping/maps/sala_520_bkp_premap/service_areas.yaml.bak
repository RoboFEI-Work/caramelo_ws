# Service Areas da sala_520.
#
# Este e o arquivo humano principal do mapa.
# final_robot_pose e sempre a pose final do robo parado em frente a mesa,
# nao a pose do centro da mesa.
service_areas:
  START:
    type: start
    frame_id: map
    final_robot_pose:
      x: 1.8241
      y: -2.7423
      yaw: -2.593809
    docking:
      approach_offset: 0.45
      linear_tolerance: 0.1
      angular_tolerance: 0.1
      use_docking: false
    manipulation_enabled: false
    notes: START - pose inicial do robo
  FINISH:
    type: finish
    frame_id: map
    final_robot_pose:
      x: 0.0
      y: 0.0
      yaw: 0.0
    docking:
      approach_offset: 0.0
      linear_tolerance: 0.05
      angular_tolerance: 0.05
      use_docking: false
    manipulation_enabled: false
    notes: "FINISH - pose final do robo"

  WS1:
    type: workstation
    frame_id: map
    final_robot_pose:
      x: -1.0607
      y: -3.2993
      yaw: 2.261142
    table:
      width: 0.8
      depth: 0.5
      height: 0.1
    docking:
      approach_offset: 0.45
      linear_tolerance: 0.1
      angular_tolerance: 0.1
      use_docking: true
    manipulation_enabled: true
    notes: WS1 - pose final do robo em frente a mesa
  WS2:
    type: workstation
    frame_id: map
    final_robot_pose:
      x: 0.5491
      y: -3.6153
      yaw: -0.999761
    table:
      width: 0.8
      depth: 0.5
      height: 0.1
    docking:
      approach_offset: 0.45
      linear_tolerance: 0.1
      angular_tolerance: 0.1
      use_docking: true
    manipulation_enabled: true
    notes: WS2 - pose final do robo em frente a mesa
  WS3:
    type: workstation
    frame_id: map
    final_robot_pose:
      x: 0.0
      y: 0.0
      yaw: 0.0
    table:
      width: 0.80
      depth: 0.50
      height: 0.10
    docking:
      approach_offset: 0.45
      linear_tolerance: 0.03
      angular_tolerance: 0.04
      use_docking: true
    manipulation_enabled: true
    notes: "WS3 - pose final do robo em frente a mesa"

  SH1:
    type: shelf
    frame_id: map
    final_robot_pose:
      x: 0.0
      y: 0.0
      yaw: 0.0
    table:
      width: 0.80
      depth: 0.50
      height: 0.10
    docking:
      approach_offset: 0.50
      linear_tolerance: 0.03
      angular_tolerance: 0.04
      use_docking: true
    manipulation_enabled: true
    notes: "SH1 - pose final do robo em frente a shelf"

  PP1:
    type: precision_placement
    frame_id: map
    final_robot_pose:
      x: 0.0
      y: 0.0
      yaw: 0.0
    table:
      width: 0.80
      depth: 0.50
      height: 0.10
    docking:
      approach_offset: 0.45
      linear_tolerance: 0.025
      angular_tolerance: 0.035
      use_docking: true
    manipulation_enabled: true
    notes: "PP1 - pose final do robo em frente ao precision placement"

  RT1:
    type: rotating_table
    frame_id: map
    final_robot_pose:
      x: 0.0
      y: 0.0
      yaw: 0.0
    table:
      width: 0.80
      depth: 0.50
      height: 0.10
    docking:
      approach_offset: 0.45
