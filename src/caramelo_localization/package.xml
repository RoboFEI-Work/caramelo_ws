<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>caramelo_localization</name>
  <version>0.0.0</version>
  <description>Localizacao do Caramelo: AMCL + map_server (global_localization.launch.py) e os servidores do Keepout Filter, com a config do RViz padrao do bringup.</description>
  <maintainer email="robofei.atwork@gmail.com">Equipe RoboFEI @Work</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>caramelo_mapping</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
